# Copy to .env and fill in. `docker compose up -d --build` reads it automatically.

# The public URL visitors use (what your reverse proxy serves). Used for links in emails.
BASE_URL=https://givingtree.example.com

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# First admin account (only used if no admins exist yet). If ADMIN_PASSWORD is empty
# a random one is generated and printed in `docker compose logs giving-tree`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional: gets an email whenever an ornament is claimed / dropped off / released.
# (Can also be changed later in Admin > Settings.)
ADMIN_NOTIFY_EMAIL=

# Timezone for deadlines and reminder timing.
TZ=America/Chicago

# --- Email (SMTP) -----------------------------------------------------------
# Leave SMTP_HOST empty to only log emails (visible in Admin > Emails and the container log).
#
# Option A - Mailcow (recommended: your own domain, better branding/deliverability)
#   1. In Mailcow, create a mailbox such as givingtree@yourdomain.com
#   2. (Recommended) In the mailbox's settings create an App Password and use it below.
#   3. Make sure SPF, DKIM and DMARC DNS records exist for the domain (Mailcow's DNS check page).
#   SMTP_HOST=mail.yourdomain.com
#   SMTP_PORT=587
#   SMTP_SECURITY=starttls
#   SMTP_USERNAME=givingtree@yourdomain.com
#   SMTP_PASSWORD=<mailbox password or app password>
#   MAIL_FROM=Giving Tree <givingtree@yourdomain.com>
#   If the app runs on the same Docker host as Mailcow, SMTP_HOST must still be a name/IP the
#   container can reach (the public hostname usually works; "localhost" will NOT).
#
# Option B - Gmail (needs 2-Step Verification + an App Password: myaccount.google.com/apppasswords)
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURITY=starttls
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=<16-character app password>
#   MAIL_FROM=Giving Tree <you@gmail.com>      (Gmail rewrites From to your account address)
#   Limit: ~500 recipients/day on personal Gmail.
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587) | ssl (port 465) | none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Giving Tree <givingtree@example.com>
# Where replies go (e.g. your personal address, if MAIL_FROM is a no-reply-style mailbox).
MAIL_REPLY_TO=

# --- Optional ---------------------------------------------------------------
# Host port to publish (your reverse proxy forwards to this).
HOST_PORT=8000
# Cookies are marked Secure automatically when BASE_URL starts with https://
# SECURE_COOKIES=true
# How often reminders / expired holds are processed (minutes).
SCHEDULER_INTERVAL_MINUTES=15
# Claim attempts allowed per IP per hour.
CLAIMS_PER_IP_PER_HOUR=30
